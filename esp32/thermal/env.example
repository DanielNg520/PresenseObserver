# Copy to .env and fill in. Never commit the real .env (it is gitignored).
# Values are injected as build-time -D macros by pre_extra_script.py.

# --- WiFi ---
# The firmware tries WPA2-Enterprise when NON_ENTERPRISE_WIFI_PASSWORD is empty
# (uses UCSD_USERNAME/UCSD_PASSWORD); otherwise it uses the normal password.
WIFI_SSID=YourWiFiName
NON_ENTERPRISE_WIFI_PASSWORD=YourWiFiPassword
# IF your password contains a #, enclose the value in '' or ""
UCSD_USERNAME=
UCSD_PASSWORD=

# --- MQTT ---
# NOTE: the broker HOST is set in include/ECE140_MQTT.h, not here.
MQTT_CLIENT_ID=esp32-thermal-01
# Must match the server's MQTT_TOPIC exactly.
MQTT_TOPIC=presence/yourname/thermal-suite
