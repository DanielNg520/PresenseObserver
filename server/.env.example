# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# --- Database ---
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me_to_a_long_random_password
DB_NAME=ta7db

# --- MQTT ---
# Option A (self-hosted Mosquitto): use the docker service name, e.g. mqtt
# Option B (managed, e.g. HiveMQ):  use your cluster host
MQTT_BROKER=broker.emqx.io
# Make this unique and non-obvious — on a shared broker it's your address.
MQTT_TOPIC=presence/yourname/thermal-suite
